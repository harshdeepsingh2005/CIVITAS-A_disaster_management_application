# ──────────────────────────────────────────────────
# CIVITAS - Environment Variables Reference
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ──────────────────────────────────────────────────

# Flask secret key — generate a strong random value:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-secret

# Database URL
# SQLite for local dev (default when DATABASE_URL is not set):
# DATABASE_URL=sqlite:///civitas.db
#
# PostgreSQL for production (Neon, Supabase, Railway, etc.):
DATABASE_URL=postgresql://user:password@host:5432/civitas

# Flask environment
FLASK_ENV=production
